{
	"schemaVersion": 1,
	"id": "reflexium",
	"version": "${version}",
	"name": "Reflexium",
	"description": "NVIDIA Reflex low latency and DLSS Super Resolution for Minecraft's Vulkan renderer.",
	"authors": ["Bambooz"],
	"contact": {
		"sources": "https://github.com/xBambooz/Reflexium",
		"issues": "https://github.com/xBambooz/Reflexium/issues"
	},
	"license": "MIT",
	"icon": "assets/reflexium/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.bambooz.reflexium.ReflexiumClient"],
		"modmenu": ["com.bambooz.reflexium.compat.ModMenuIntegration"],
		"sodium:config_api_user": ["com.bambooz.reflexium.compat.SodiumConfigIntegration"]
	},
	"mixins": [
		{ "config": "reflexium.mixins.json", "environment": "client" },
		{ "config": "reflexium.compat.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25"
	},
	"suggests": {
		"modmenu": "*",
		"sodium": "*"
	},
	"breaks": {
		"nvidia-reflex-mod": "*"
	}
}
